{
  "openapi": "3.0.3",
  "info": {
    "title": "Order Status API",
    "version": "1.0.0",
    "description": "Demo order service for customer support agents. Look up an order's status and shipping details, list a customer's orders by email, and create return requests for delivered orders."
  },
  "servers": [{ "url": "https://REPLACE_WITH_RAILWAY_DOMAIN" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/orders/{orderNumber}": {
      "get": {
        "operationId": "getOrderStatus",
        "summary": "Get order status",
        "description": "Returns the current status, items, total, carrier, tracking number, estimated delivery date and any return requests for a single order. Use when a customer asks where their order is or what its status is.",
        "parameters": [
          { "name": "orderNumber", "in": "path", "required": true, "description": "The order number, for example ORD-1001.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Order details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "Order not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listCustomerOrders",
        "summary": "List a customer's orders",
        "description": "Lists all orders placed by a customer, identified by their email address, with order number, status, date and total. Use when the customer does not know their order number.",
        "parameters": [
          { "name": "email", "in": "query", "required": true, "description": "The customer's email address.", "schema": { "type": "string", "format": "email" } }
        ],
        "responses": {
          "200": { "description": "Customer orders", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderList" } } } },
          "400": { "description": "Email missing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders/{orderNumber}/returns": {
      "post": {
        "operationId": "createReturnRequest",
        "summary": "Create a return request",
        "description": "Creates a return (RMA) request for a Delivered order and returns the return ID, refund amount and next steps. Only Delivered orders are eligible. If no SKUs are given, all items on the order are returned.",
        "parameters": [
          { "name": "orderNumber", "in": "path", "required": true, "description": "The order number to return items from, for example ORD-1002.", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReturnRequestInput" } } }
        },
        "responses": {
          "201": { "description": "Return request created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReturnRequest" } } } },
          "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Order not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Order not eligible for return", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "x-api-key" }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "properties": { "sku": { "type": "string" }, "name": { "type": "string" }, "quantity": { "type": "integer" }, "price": { "type": "number" } }
      },
      "Order": {
        "type": "object",
        "properties": {
          "orderNumber": { "type": "string" },
          "customerEmail": { "type": "string" },
          "status": { "type": "string", "enum": ["Processing", "Shipped", "Delivered", "Cancelled"] },
          "orderDate": { "type": "string", "format": "date" },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "carrier": { "type": "string", "nullable": true },
          "trackingNumber": { "type": "string", "nullable": true },
          "estimatedDelivery": { "type": "string", "format": "date", "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
          "returns": { "type": "array", "items": { "$ref": "#/components/schemas/ReturnRequest" } }
        }
      },
      "OrderSummary": {
        "type": "object",
        "properties": { "orderNumber": { "type": "string" }, "status": { "type": "string" }, "orderDate": { "type": "string" }, "total": { "type": "number" }, "currency": { "type": "string" }, "itemCount": { "type": "integer" } }
      },
      "OrderList": {
        "type": "object",
        "properties": { "customerEmail": { "type": "string" }, "count": { "type": "integer" }, "orders": { "type": "array", "items": { "$ref": "#/components/schemas/OrderSummary" } } }
      },
      "ReturnRequestInput": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "enum": ["Damaged", "Wrong Item", "Wrong Size", "Not As Described", "Changed Mind", "Other"], "description": "Why the customer is returning the items." },
          "skus": { "type": "array", "items": { "type": "string" }, "description": "Optional. SKUs to return. Defaults to all items on the order." },
          "comments": { "type": "string", "description": "Optional free-text comments from the customer." }
        }
      },
      "ReturnRequest": {
        "type": "object",
        "properties": { "returnId": { "type": "string" }, "orderNumber": { "type": "string" }, "status": { "type": "string" }, "reason": { "type": "string" }, "comments": { "type": "string" }, "skus": { "type": "array", "items": { "type": "string" } }, "refundAmount": { "type": "number" }, "createdAt": { "type": "string", "format": "date-time" }, "instructions": { "type": "string" } }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
      }
    }
  }
}
